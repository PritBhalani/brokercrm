# Copy to `.env` for local API or set these in Render (Web Service → Environment).

# Required for MongoDB Atlas (or any MongoDB deployment)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/DATABASE?retryWrites=true&w=majority

# Required in production (NODE_ENV=production). Use a long random string.
JWT_SECRET=change-me-to-a-long-random-secret

# Render sets PORT automatically; optional locally (default 3000).
PORT=3000

# Use production on Render (Render also sets RENDER=true; both enable production mode).
NODE_ENV=production

# Comma-separated allowed browser origins for CORS + Socket.io (your Vercel app URL).
# Example: https://your-app.vercel.app,https://www.yourdomain.com
# Alternative single URL:
# FRONTEND_URL=https://your-app.vercel.app
CORS_ORIGINS=https://your-app.vercel.app

# Optional: Gemini / AI features (if used by the app)
GEMINI_API_KEY=

# Optional: expose raw error details in JSON responses (never enable in public production)
# DEBUG_API_ERRORS=1

# Optional: legacy alias for debug (same effect as DEBUG_API_ERRORS)
# VERCEL_DEBUG=1
