# Vite reads these at BUILD time. Set them in Vercel → Project → Settings → Environment Variables
# (Production + Preview) and redeploy after changing.

# Public URL of your Render API (no trailing slash). Use ONE of these — priority is:
#   VITE_API_BASE_URL → VITE_API_URL → REACT_APP_API_URL
VITE_API_BASE_URL=https://your-api.onrender.com

# Alternative names (CRA-style migration):
# VITE_API_URL=https://your-api.onrender.com
# REACT_APP_API_URL=https://your-api.onrender.com

# Optional: Gemini key if referenced in the Vite build (see vite.config.ts)
# GEMINI_API_KEY=

# Local dev only: where Vite proxies /api (default http://127.0.0.1:3000)
# VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:3000
