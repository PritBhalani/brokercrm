# Local full-stack: copy to `.env` in the repo root (`npm run dev`).
# Split deploy: use `backend.env.example` on Render and `frontend.env.example` on Vercel.

# --- Backend (Express + Socket.io) ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/DATABASE
JWT_SECRET=dev-only-change-in-production
PORT=3000
# Dev UI origin when using Vite on another port:
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Optional ---
# GEMINI_API_KEY=
# VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:3000

# --- Frontend (Vite build / Vercel) — set in Vercel dashboard, not always in this file ---
# VITE_API_BASE_URL=https://your-api.onrender.com
