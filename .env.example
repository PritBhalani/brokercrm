# Copy to `.env` for local dev. On Vercel: Project → Settings → Environment Variables (Production + Preview).

# Required
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/brokercrm?retryWrites=true&w=majority
JWT_SECRET=use-a-long-random-string-at-least-32-chars

# --- API on your PC + UI on Vercel ---
# On the machine running `npm run dev` (or production API): allow your Vercel origin(s), comma-separated.
# CORS_ORIGINS=https://your-app.vercel.app,https://your-app-*.vercel.app
#
# On Vercel (build-time): where the browser should call your API (ngrok / Cloudflare Tunnel / public IP).
# Must redeploy after changing. No trailing slash.
# VITE_API_BASE_URL=https://xxxx.ngrok-free.app

# Optional (Gemini features in app, if used)
GEMINI_API_KEY=

# Temporary: set to 1 on Vercel to see real error messages in JSON (remove after debugging)
# VERCEL_DEBUG=1
